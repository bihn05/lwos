---
import SiteLayout from "../layouts/SiteLayout.astro";
import { REPO, WIKI, AUTHOR, AUTHOR_URL } from "../data/site";
---

<SiteLayout
  title="404 - LWOS"
  windowTitle="The page cannot be displayed"
  sections={[]}
>
  <h2>The page cannot be displayed</h2>
  <p>The page you are looking for is currently unavailable. It may have been moved or
  renamed, or it may simply not exist yet &mdash; most of this site is still being written.</p>

  <hr>

  <p>Try one of these instead:</p>
  <ul class="links">
    <li><a href="/">LWOS home page</a></li>
    <li><a href={REPO}>Source on GitHub</a></li>
    <li><a href={WIKI}>Wiki</a></li>
  </ul>

  <hr class="rb">

  <p style="margin-top:14px"><a class="btn95" href="/">Back to the home page</a></p>

  <p class="foot">
    <img class="wmimg" src="/assets/img/wordmark-mini.png" width="147" height="45" alt="LWOS">
    <br><br>Copyleft 2026 &middot; Page by <a href={AUTHOR_URL}>@{AUTHOR}</a> &middot; An IBM-PC-looking OS that does not need a BIOS
  </p>
</SiteLayout>
