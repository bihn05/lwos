{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lwos-site",
  "compatibility_date": "2026-10-01",

  // 静态资源 + 一条 /demo-image 代理路由 (worker.js): 匹配到 dist/ 静态资源
  // 的请求 Cloudflare 直发, 免费不限量, 不进脚本; 只有 demo 页拉镜像的那
  // 一条 /demo-image* 请求会跑脚本, 走普通 Worker 额度。
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // 匹配不到文件时用 dist/404.html 回应。
    "not_found_handling": "404-page"

    // html_handling 保持默认的 auto-trailing-slash,
    // 也就是把 /wiki/ 映射到 /wiki/index.html。
  }
}
